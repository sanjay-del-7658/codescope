# Featherless (OpenAI-compatible) — enables query rewriting + grounded explanations
FEATHERLESS_API_KEY=
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Embeddings: auto | st | api | lsa
#   auto -> sentence-transformers if installed, else api if EMBED_API_MODEL set, else lsa (offline)
EMBED_BACKEND=auto
ST_MODEL=BAAI/bge-small-en-v1.5
EMBED_API_MODEL=

# Ranking: linear (weighted normalised scores) | rrf (reciprocal rank fusion)
FUSION=linear

MAX_FILE_KB=500
